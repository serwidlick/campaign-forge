{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "**" }]
    },
    "dialog:default",
    "store:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.anthropic.com/*" }]
    }
  ]
}
