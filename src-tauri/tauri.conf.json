{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campaign Forge",
  "version": "0.1.1",
  "identifier": "dev.campaignforge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Campaign Forge",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3RDZCNDQ3MjQ3QUFGQjUKUldTMXIzb2tSN1RXTi9aRURDWjVPSW1WMTBwR3ZYM2FMczhGcjZ1a0JOdjlEczI2MkxWU2NaS2kK",
      "endpoints": [
        "https://github.com/serwidlick/campaign-forge/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "nsis", "dmg", "appimage", "deb"],
    "publisher": "David Levey",
    "shortDescription": "Local-first campaign manager for tabletop game masters",
    "longDescription": "World bible, maps, sessions, timeline and journals for tabletop RPG campaigns, stored as plain Markdown files on your own disk. Play at a table over the local network.",
    "copyright": "Copyright © 2026 David Levey",
    "category": "Game",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
