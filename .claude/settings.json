{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "graphify update . >/dev/null 2>&1 && graphify export wiki >/dev/null 2>&1 || true",
            "timeout": 60,
            "statusMessage": "Updating graphify graph and wiki"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "graphify update . >/dev/null 2>&1 && graphify export wiki >/dev/null 2>&1 || true",
            "timeout": 60,
            "statusMessage": "Updating graphify graph and wiki"
          }
        ]
      }
    ]
  }
}
